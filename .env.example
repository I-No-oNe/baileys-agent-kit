# Local file storage is automatic and free. Override its OS-specific directory only when needed.
WA_STORAGE_BACKEND=file
WA_STATE_DIR=
WA_STATE_ENCRYPTION_KEY=
# Optional for non-interactive one-time-code pairing. Prefer --phone-number for local interactive use.
WA_PHONE_NUMBER=
# Optional hosted/distributed backend. Set both values and WA_STORAGE_BACKEND=upstash.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
PAIRING_BROKER_URL=https://your-pairing-project.vercel.app
PAIRING_PUBLIC_URL=https://your-pairing-project.vercel.app
PAIRING_BROKER_SECRET=generate-a-long-random-secret
WA_ACCOUNT_ID=default
PORT=3417
WA_ALLOWED_RECIPIENTS=
WA_MAX_SENDS_PER_DAY=50
WA_MAX_SENDS_PER_RECIPIENT_PER_DAY=10
WA_MAX_UNIQUE_RECIPIENTS_PER_DAY=20
# Leave any WA_MAX_* value empty/whitespace for no limit. Same here means no send delay.
WA_MINIMUM_SEND_INTERVAL_MS=3500
WA_FAILURE_THRESHOLD=3
WA_CIRCUIT_BREAKER_SECONDS=1800
WA_ENABLE_GROUP_ADMIN=false
